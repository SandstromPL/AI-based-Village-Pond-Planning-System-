# ──────────────────────────────────────────
#  Application Configuration
#  Edit values here or override via .env
# ──────────────────────────────────────────

# Server
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=info

# ── Cross-cutting resilience ──────────────
# Shared by all four external-provider fetch functions (OpenZenith,
# Open-Elevation, OpenTopoData, Overpass). After a provider is seen
# rate-limited (HTTP 429/503) or unreachable (connection error), further
# requests skip it immediately for this long instead of a brand-new
# request re-discovering the same failure from scratch every time.
CIRCUIT_BREAKER_COOLDOWN_S=60

# ── Terrain Processing ──────────────────
# DEM grid resolution in metres (after UTM projection)
DEM_RESOLUTION_M=30
# Percentage of grid padding around the contour/selected-area bounding box on
# each side, so flow-routing algorithms don't get edge artifacts right at the
# boundary. For /analyzeArea this means a candidate/catchment can land in
# that padding margin, outside the polygon the user actually drew — see
# generate_candidates()'s `selection_polygon` filter, which rejects an
# accepted candidate for landing there (catchment boundaries are left
# unrestricted; a real drainage basin isn't bounded by an arbitrary polygon).
DEM_BBOX_PADDING_FRAC=0.1
# Interpolation method: linear | cubic | nearest
DEM_INTERP_METHOD=linear

# ── Candidate Generation ────────────────
# Top-N flow-accumulation percentile threshold for convergence seeds
FLOW_ACC_PERCENTILE=99
# Maximum slope (degrees) for a candidate to be accepted
MAX_SLOPE_DEG=15
# Minimum straight-line separation between candidates (metres)
MIN_CANDIDATE_DISTANCE_M=100
# Maximum number of candidates to return
MAX_CANDIDATES=5
# Minimum catchment area (km²) for a candidate to be accepted
MIN_CATCHMENT_KM2=0.005

# ── Scoring Weights (must sum to 1.0) ──
SCORE_WEIGHT_CATCHMENT=0.35
SCORE_WEIGHT_FLOW_ACC=0.25
SCORE_WEIGHT_SLOPE=0.20
SCORE_WEIGHT_RELIEF=0.10
SCORE_WEIGHT_DEPRESSION=0.10

# ── Elevation: Copernicus DEM (tried first, ahead of OpenZenith) ──
# Read directly as Cloud-Optimized GeoTIFF tiles from public AWS S3 Open
# Data storage — a static file read, not a rate-limited REST API call, so
# there's no per-request quota to exhaust. Verified live: no credentials
# needed, and the sampled elevation matched this project's own real KML
# contour dataset's known range for the same area. The OpenZenith/Open-
# Elevation/OpenTopoData cascade below remains the fallback for whatever
# this tier can't resolve (including it being disabled or unreachable).
COPERNICUS_DEM_ENABLED=true
COPERNICUS_DEM_BUCKET_URL=https://copernicus-dem-30m.s3.amazonaws.com
COPERNICUS_DEM_REQUEST_TIMEOUT_S=15

# ── Elevation: OpenZenith (fallback tier 1) ──────
# Verified working with no API key: GET /api/elevation and POST
# /api/elevation/batch (up to 2000 points/request, ~1-2s). Note:
# openzenith.org is the correct domain — a docs mirror at
# openzenith.cyopsys.com sits behind an unsolvable Cloudflare JS challenge
# for server-side clients, don't use that one.
OPENZENITH_URL=https://openzenith.org
OPENZENITH_REQUEST_TIMEOUT_S=15
OPENZENITH_MAX_RETRIES=1

# ── Rainfall: Open-Meteo Historical Weather API ──
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
# No API key needed for the Open-Meteo public endpoint
RAINFALL_HISTORY_START_YEAR=2015
# RAINFALL_HISTORY_END_YEAR=2024  # defaults to last complete calendar year
RAINFALL_REQUEST_TIMEOUT_S=10

# ── Planning-level runoff and pond assumptions ──
# Rational Method: annual_runoff_m3 = C * annual_rainfall_m * catchment_area_m2
RUNOFF_COEFFICIENT_DEFAULT=0.35
POND_RETENTION_FACTOR=0.80
POND_DEFAULT_DEPTH_M=3.0
POND_STEEP_SLOPE_THRESHOLD_DEG=5.0
POND_STEEP_SLOPE_DEPTH_M=2.0

# [EXTERNAL_API_PLACEHOLDER: NASA POWER rainfall API]
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point

# [EXTERNAL_API_PLACEHOLDER: IMD rainfall API]
IMD_API_KEY=YOUR_KEY_HERE
IMD_BASE_URL=https://imdpune.gov.in/api

# ── Elevation: Open-Elevation + OpenTopoData (fallback chain, for
# map-selected-area analysis) — only used for points OpenZenith couldn't
# provide (including OpenZenith being fully unreachable). A point that
# fails every tier is NOT cached (only real values are) — a real bug had
# a failed point served from cache forever, even after the network
# recovered; now the next request just retries it. ──
OPEN_ELEVATION_URL=https://api.open-elevation.com/api/v1/lookup
ELEVATION_REQUEST_TIMEOUT_S=15
# Outer batch size, sized for OpenZenith's large per-request limit (2000).
ELEVATION_BATCH_SIZE=1000
# Sub-batch size used only when re-chunking OpenZenith's leftovers for the
# Open-Elevation/OpenTopoData fallback chain — their practical limit is
# far smaller than OpenZenith's.
ELEVATION_FALLBACK_BATCH_SIZE=50
ELEVATION_MAX_RETRIES=1
# Batches with cache misses are fetched concurrently, bounded by this many
# in-flight requests at once.
ELEVATION_MAX_CONCURRENT_REQUESTS=12
# Hard wall-clock cap on the whole elevation fetch for an area analysis,
# regardless of grid size or how many batches are still retrying.
ELEVATION_TOTAL_BUDGET_S=45
# Fallback provider (different domain/infra) used only for points neither
# OpenZenith nor Open-Elevation could return. Its public demo server
# documents a 1 call/second limit — calls to it are serialized to respect
# that regardless of ELEVATION_MAX_CONCURRENT_REQUESTS.
ELEVATION_FALLBACK_ENABLED=true
OPENTOPODATA_URL=https://api.opentopodata.org/v1/srtm90m

# ── Map-selected-area analysis limits ──
# Bounds compute/API cost for a user-drawn polygon (POST /analyzeArea)
SELECTED_AREA_MAX_KM2=25
SELECTED_AREA_MAX_GRID_POINTS=2500

# ── Land-use constraint filter (avoid buildings/roads/rivers/water) ──
# Keeps pond candidates off existing structures/water features using OSM
# data via the public Overpass API. Failure to reach Overpass just skips
# this filter for the analysis (plus a warning) rather than blocking it.
LANDUSE_CONSTRAINT_ENABLED=true
# overpass-api.de returned HTTP 406, and this instance initially returned
# HTTP 403 ("only available to white-listed usages") for our real query —
# both were bot-filtering/identification gates, fixed by sending a
# descriptive User-Agent with every request (app/utils/http_client.py),
# not a capacity problem. A prior default, maps.mail.ru, turned out to be
# an unaffiliated third-party proxy (not on OSM's own Overpass status
# page) and measured at 13-15s/request; this instance is a recognized
# community-run one and was live-tested working once the User-Agent fix
# was in place.
OVERPASS_URL=https://overpass.openstreetmap.fr/api/interpreter
OVERPASS_REQUEST_TIMEOUT_S=20
OVERPASS_MAX_RETRIES=1
# Hard wall-clock cap on the whole Overpass fetch regardless of retry
# count — mirrors ELEVATION_TOTAL_BUDGET_S. For /analyzeArea this fetch
# is launched concurrently with the elevation fetch (both only need the
# drawn polygon's bbox), so it overlaps rather than stacking after it.
OVERPASS_TOTAL_BUDGET_S=25
# Buffer distances in metres around each feature type.
LANDUSE_BUILDING_BUFFER_M=100
LANDUSE_ROAD_BUFFER_M=50
LANDUSE_RIVER_BUFFER_M=30
LANDUSE_POWERLINE_BUFFER_M=75
